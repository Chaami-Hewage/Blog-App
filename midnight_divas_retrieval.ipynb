from collections import defaultdict

def train_one_epoch(epoch):
    model.train()
    running = defaultdict(float)
    for imgs, labels, _ in tqdm(train_loader, desc=f"Epoch {epoch+1}/{MAX_EPOCHS}"):
        imgs = imgs.to(DEVICE); labels = labels.to(DEVICE)
        opt.zero_grad(set_to_none=True)
        emb = model(imgs)
        loss_trip = triplet_loss(emb, labels, miner(emb, labels))
        loss = loss_trip
        if arcface_loss is not None:
            loss_arc = arcface_loss(emb, labels)
            loss = loss + loss_arc
            running['arcface'] += loss_arc.item()
        loss.backward()
        opt.step()
        running['triplet'] += loss_trip.item()
        running['total'] += loss.item()
        running['batches'] += 1
    for k in list(running.keys()):
        if k != 'batches':
            running[k] /= max(1, running['batches'])
    return dict(running)

@torch.no_grad()
def extract_embeddings(dataloader):
    model.eval()
    all_embs, all_labels, all_paths = [], [], []
    for imgs, labels, paths in tqdm(dataloader, desc='Extracting embeddings'):
        imgs = imgs.to(DEVICE)
        emb = model(imgs).detach().cpu().numpy()
        all_embs.append(emb)
        all_labels.append(labels.numpy())
        all_paths.extend(paths)
    all_embs = np.concatenate(all_embs, axis=0)
    all_labels = np.concatenate(all_labels, axis=0)
    return all_embs, all_labels, all_paths

def compute_retrieval_metrics(embeddings, labels, k_vals=(1,5,10)):
    xb = embeddings.astype(np.float32)
    index = faiss.IndexFlatIP(xb.shape[1])
    index.add(xb)
    sims, ids = index.search(xb, max(k_vals)+1)
    recalls = {k: 0 for k in k_vals}
    ap_list = []
    for i in range(len(labels)):
        y_true = (labels[ids[i]] == labels[i]).astype(np.int32)
        y_true = y_true[1:]
        for k in k_vals:
            recalls[k] += (y_true[:k].sum() > 0)
        topk = min(5, len(y_true))
        if topk > 0:
            ap = average_precision_score(y_true[:topk], sims[i][1:1+topk])
            if not math.isnan(ap):
                ap_list.append(ap)
    n = len(labels)
    recall_scores = {f"R@{k}": recalls[k] / n for k in k_vals}
    map5 = float(np.mean(ap_list)) if len(ap_list) > 0 else 0.0
    return recall_scores, map5

best_score, best_state = -1, None
for epoch in range(MAX_EPOCHS):
    train_stats = train_one_epoch(epoch)
    lr_sched.step()
    val_emb, val_lbl, val_paths = extract_embeddings(val_loader)
    recall_scores, map5 = compute_retrieval_metrics(val_emb, val_lbl, k_vals=(1,5,10))
    print(f"Epoch {epoch+1}: Loss={train_stats['total']:.4f}, Triplet={train_stats['triplet']:.4f}, ArcFace={train_stats.get('arcface',0):.4f} | R@1={recall_scores['R@1']:.3f}, R@5={recall_scores['R@5']:.3f}, R@10={recall_scores['R@10']:.3f}, mAP@5={map5:.3f}")
    score = recall_scores['R@1'] + map5
    if score > best_score:
        best_score = score
        best_state = { 'model': model.state_dict(), 'recall_scores': recall_scores, 'map5': map5, 'epoch': epoch+1 }

