class ResNet50Embed(nn.Module):
    def __init__(self, embed_dim=EMBED_DIM, pretrained=True):
        super().__init__()
        self.backbone = resnet50(weights=ResNet50_Weights.IMAGENET1K_V2 if pretrained else None)
        in_features = self.backbone.fc.in_features
        self.backbone.fc = nn.Identity()
        self.embedding = nn.Sequential(
            nn.Linear(in_features, embed_dim, bias=False),
            nn.BatchNorm1d(embed_dim)
        )
    def forward(self, x):
        feats = self.backbone(x)
        emb = self.embedding(feats)
        emb = F.normalize(emb, p=2, dim=1)
        return emb

num_classes = len(product_to_class)
model = ResNet50Embed(EMBED_DIM, pretrained=True).to(DEVICE)

opt = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)
lr_sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=MAX_EPOCHS)

miner = miners.MultiSimilarityMiner(epsilon=0.1)
triplet_loss = losses.TripletMarginLoss(margin=MARGIN, distance=losses.CosineSimilarity())
arcface_loss = losses.ArcFaceLoss(num_classes=num_classes, embedding_size=EMBED_DIM, margin=ARCFACE_MARGIN, scale=ARCFACE_SCALE).to(DEVICE) if USE_ARCFACE else None# Dataset and loaders
class ProductDataset(Dataset):
    def __init__(self, items, transform):
        self.items = items
        self.transform = transform

    def __len__(self):
        return len(self.items)

    def __getitem__(self, idx):
        img_path, label = self.items[idx]
        img = load_crop_or_original(img_path)
        if img is None:
            img = np.zeros((IMG_SIZE, IMG_SIZE, 3), dtype=np.uint8)
        img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
        aug = self.transform(image=img)
        tensor = aug['image']
        return tensor, label, img_path

train_ds = ProductDataset(train_items, transform=train_tf)
val_ds   = ProductDataset(val_items,   transform=val_tf)

labels_train = [y for _, y in train_items]
m_sampler = samplers.MPerClassSampler(labels=labels_train, m=M_PER_CLASS, length_before_new_iter=len(train_ds), seed=SEED)

train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, sampler=m_sampler, num_workers=NUM_WORKERS, pin_memory=True, drop_last=True)
val_loader   = DataLoader(val_ds,   batch_size=128, shuffle=False, num_workers=NUM_WORKERS, pin_memory=True)# Transforms
train_tf = A.Compose([
    A.LongestMaxSize(max_size=IMG_SIZE, interpolation=cv2.INTER_CUBIC),
    A.PadIfNeeded(min_height=IMG_SIZE, min_width=IMG_SIZE, border_mode=cv2.BORDER_REFLECT_101),
    A.ShiftScaleRotate(shift_limit=0.05, scale_limit=0.2, rotate_limit=15, p=AUG_PROB),
    A.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.15, hue=0.02, p=AUG_PROB),
    A.RandomResizedCrop(IMG_SIZE, IMG_SIZE, scale=(0.7, 1.0), ratio=(0.8, 1.25), p=0.3),
    A.HorizontalFlip(p=0.5),
    A.Normalize(),
    ToTensorV2()
])

val_tf = A.Compose([
    A.LongestMaxSize(max_size=IMG_SIZE, interpolation=cv2.INTER_CUBIC),
    A.PadIfNeeded(min_height=IMG_SIZE, min_width=IMG_SIZE, border_mode=cv2.BORDER_REFLECT_101),
    A.Normalize(),
    ToTensorV2()
])

# Helper to load image honoring read-only mode
def load_crop_or_original(img_path):
    if READ_ONLY_CROPS:
        return get_or_make_crop_readonly(img_path)
    # Else default behavior: will compute and save if missing
    return get_or_make_crop(img_path, model=clothes_detector, conf=CONF_THRESHOLD)# Dataset scanning and optional cropping cache

def path_hash(p):
    import hashlib
    return hashlib.md5(p.encode('utf-8')).hexdigest()

def cached_crop_path(img_path):
    h = path_hash(img_path)
    ext = os.path.splitext(img_path)[1].lower() or '.jpg'
    return os.path.join(CACHE_DIR, f"{h}{ext}")

# Placeholder for external detector (set to None to skip)
clothes_detector = None

def separate_clothes_from_model(model, image_path, confidence_threshold=30):
    # If you integrate a DeepFashion2 model in Colab, adapt its API here.
    result = model.predict(image_path, confidence=confidence_threshold)
    img = cv2.imread(image_path)
    if img is None:
        return None, None
    for pred in result.predictions:
        pred_dict = pred.json()
        if 'points' in pred_dict and pred_dict['points']:
            pts = np.array([[p['x'], p['y']] for p in pred_dict['points']], dtype=np.int32)
            x, y, w, h = cv2.boundingRect(pts)
        else:
            cx, cy = pred_dict['x'], pred_dict['y']
            w, h = pred_dict['width'], pred_dict['height']
            x = int(cx - w / 2); y = int(cy - h / 2)
            w = int(w); h = int(h)
        pad = 0.1
        x = max(0, int(x - w * pad))
        y = max(0, int(y - h * pad))
        w = int(w * (1 + 2 * pad))
        h = int(h * (1 + 2 * pad))
        h_img, w_img = img.shape[:2]
        x2 = min(w_img, x + w); y2 = min(h_img, y + h)
        x = max(0, x); y = max(0, y)
        if x2 > x and y2 > y:
            cropped = img[y:y2, x:x2]
            return cropped, (x, y, x2 - x, y2 - y)
        break
    return img, None

def get_or_make_crop(image_path, model=None, conf=30):
    out_path = cached_crop_path(image_path)
    if os.path.exists(out_path):
        im = cv2.imread(out_path)
        if im is not None:
            return im
    im = cv2.imread(image_path)
    if im is None:
        return None
    if model is not None:
        try:
            cropped, bbox = separate_clothes_from_model(model, image_path, confidence_threshold=conf)
            if cropped is not None and cropped.size > 0:
                cv2.imwrite(out_path, cropped)
                return cropped
        except Exception as e:
            pass
    cv2.imwrite(out_path, im)
    return im

