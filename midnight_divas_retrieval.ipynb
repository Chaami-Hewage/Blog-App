@torch.no_grad()
def show_topk(query_path, index, ref_paths, k=5):
    img = get_or_make_crop(query_path, model=clothes_detector, conf=CONF_THRESHOLD)
    if img is None:
        print('Query image read failed:', query_path)
        return
    rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
    tens = val_tf(image=rgb)['image'].unsqueeze(0).to(DEVICE)
    q_emb = model(tens).detach().cpu().numpy().astype(np.float32)
    sims, ids = index.search(q_emb, k)
    ids = ids[0]; sims = sims[0]
    plt.figure(figsize=(14, 3))
    ax = plt.subplot(1, k+1, 1); ax.imshow(rgb); ax.set_title('Query'); ax.axis('off')
    for i in range(k):
        cand = cv2.imread(val_paths[ids[i]])
        cand = cv2.cvtColor(cand, cv2.COLOR_BGR2RGB)
        ax = plt.subplot(1, k+1, i+2)
        ax.imshow(cand); ax.set_title(f'{i+1}: {sims[i]:.2f}'); ax.axis('off')
    plt.tight_layout(); plt.show()

