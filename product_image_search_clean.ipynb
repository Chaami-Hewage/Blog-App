# Demo: automatic queries for swimsuit and thigh chain

def find_image_with_label(target_labels: List[str]) -> str:
    for p in all_images:
        try:
            pil = Image.open(p).convert('RGB')
        except:
            continue
        dets = ov_detect(pil, OV_CLASSES, DET_SCORE_THRESH)
        labels = {d['label'] for d in dets}
        if any(t in labels for t in target_labels):
            return p
    return random.choice(all_images) if all_images else None

query_specs = [
    (['swimsuit', 'bikini', 'one-piece swimsuit', 'two-piece swimsuit'], 'swimsuit'),
    (['thigh chain', 'leg chain', 'body chain'], 'thigh_chain')
]

out_paths = []
for targets, name in query_specs:
    qpath = find_image_with_label(targets)
    if qpath is None:
        continue
    q_img = Image.open(qpath).convert('RGB')
    q_crop, inds, sims, meta = search_by_image(q_img, topk=12)
    out = OUTPUTS_DIR / f'{name}_query_and_results.jpg'
    out_paths.append(str(visualize_results(q_crop, inds, meta, title=name, out_path=out)))

print('Saved results:', out_paths)
out_paths# Query and visualization
from math import ceil

def load_index():
    feats = np.load(INDEX_DIR / 'features.npy')
    idx = faiss.read_index(str(INDEX_DIR / 'faiss.index'))
    meta = [json.loads(l) for l in open(INDEX_DIR / 'metadata.jsonl')]
    return feats, idx, meta

@torch.no_grad()
def detect_best_crop(pil: Image.Image, classes=OV_CLASSES):
    dets = ov_detect(pil, classes, DET_SCORE_THRESH)
    if not dets:
        return None
    best = max(dets, key=lambda d: d['score'])
    (crop, _det) = crop_boxes(pil, [best], expand=0.05)[0]
    return crop, best


def search_by_image(pil_query: Image.Image, topk=12):
    best = detect_best_crop(pil_query)
    crop = pil_query if best is None else best[0]
    q = embed_pil(crop)
    _, idx, meta = load_index()
    sims, inds = idx.search(q, topk)
    return crop, inds[0], sims[0], meta


def make_grid(images: List[Image.Image], cols=4, pad=4, bg=(255,255,255)) -> Image.Image:
    if len(images) == 0:
        return Image.new('RGB', (512, 512), color=bg)
    w, h = images[0].size
    rows = ceil(len(images) / cols)
    grid = Image.new('RGB', (cols*w + (cols+1)*pad, rows*h + (rows+1)*pad), color=bg)
    x = pad
    y = pad
    for i, im in enumerate(images):
        grid.paste(im, (x, y))
        x += w + pad
        if (i+1) % cols == 0:
            x = pad
            y += h + pad
    return grid


def visualize_results(query_img: Image.Image, inds, meta, title: str, out_path: Path, thumb_size=(256,256)) -> Path:
    thumbs = []
    for i in inds:
        m = meta[int(i)]
        try:
            im = Image.open(m['crop_path']).convert('RGB').resize(thumb_size)
        except:
            im = Image.new('RGB', thumb_size, color=(200,200,200))
        thumbs.append(im)
    grid = make_grid(thumbs, cols=4)
    qthumb = query_img.resize(thumb_size)
    header = Image.new('RGB', (grid.width, qthumb.height+16), color=(240,240,240))
    header.paste(qthumb, ((header.width - qthumb.width)//2, 8))
    canvas = Image.new('RGB', (grid.width, header.height + grid.height), color=(255,255,255))
    canvas.paste(header, (0,0))
    canvas.paste(grid, (0, header.height))
    canvas.save(out_path)
    return out_path# CLIP embedder and index builder
clip_model, _, clip_preprocess = open_clip.create_model_and_transforms('ViT-L-14', pretrained='openai')
clip_model = clip_model.to(DEVICE)
clip_model.eval()

@torch.no_grad()
def embed_pil(pil_img: Image.Image) -> np.ndarray:
    img = clip_preprocess(pil_img).unsqueeze(0).to(DEVICE)
    feat = clip_model.encode_image(img)
    feat = feat / feat.norm(dim=-1, keepdim=True)
    return feat.detach().cpu().numpy().astype('float32')

metadata = []
features = []

def save_crop(pil_img: Image.Image, src_path: str, det: dict, idx: int) -> Path:
    rel = Path(src_path).relative_to(DATASET_DIR)
    out_dir = CROPS_DIR / rel.parent
    out_dir.mkdir(parents=True, exist_ok=True)
    stem = rel.stem
    label = det['label'].replace(' ', '_')
    out_path = out_dir / f"{stem}_det{idx}_{label}.jpg"
    pil_img.save(out_path, quality=95)
    return out_path

# Build the dataset index
total_crops = 0
for img_path in tqdm(all_images, desc='Indexing images'):
    try:
        pil = Image.open(img_path).convert('RGB')
    except Exception as e:
        continue
    dets = ov_detect(pil, OV_CLASSES, DET_SCORE_THRESH)
    crops = crop_boxes(pil, dets, expand=0.05) if len(dets) else []
    if not crops:
        continue
    for i, (crop, det) in enumerate(crops):
        feat = embed_pil(crop)[0]
        features.append(feat)
        crop_path = save_crop(crop, img_path, det, i)
        metadata.append({
            'source_image': str(Path(img_path).resolve()),
            'crop_path': str(crop_path.resolve()),
            'bbox': det['bbox_expanded'],
            'label': det['label'],
            'score': det['score']
        })
        total_crops += 1
        if total_crops >= MAX_CROPS:
            break
    if total_crops >= MAX_CROPS:
        break

if len(features) == 0:
