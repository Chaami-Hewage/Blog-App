features = np.stack(features, axis=0)
np.save(INDEX_DIR / 'features.npy', features)
with open(INDEX_DIR / 'metadata.jsonl', 'w') as f:
    for m in metadata:
        f.write(json.dumps(m) + '\n')

# Build FAISS index (cosine via inner product)
dim = features.shape[1]
index = faiss.IndexFlatIP(dim)
index.add(features)
faiss.write_index(index, str(INDEX_DIR / 'faiss.index'))
print('Index built:', index.ntotal, 'vectors; dim=', dim)
# Detection (OWL-ViT) with lightweight NMS
owl_processor = Owlv2Processor.from_pretrained('google/owlv2-base-patch16')
owl_model = Owlv2ForObjectDetection.from_pretrained('google/owlv2-base-patch16').to(DEVICE)
owl_model.eval()

@torch.no_grad()
def ov_detect(image: Image.Image, class_texts: List[str], score_thresh: float=0.25) -> List[Dict]:
    inputs = owl_processor(text=[[c] for c in class_texts], images=image, return_tensors='pt')
    inputs = {k: v.to(DEVICE) for k, v in inputs.items()}
    outputs = owl_model(**inputs)
    target_sizes = torch.tensor([image.size[::-1]]).to(DEVICE)
    results = owl_processor.post_process_object_detection(outputs=outputs, target_sizes=target_sizes)
    res = results[0]

    boxes = res['boxes'].detach().cpu().numpy()  # xyxy
    scores = res['scores'].detach().cpu().numpy()
    labels = res['labels'].detach().cpu().numpy()

    kept = []
    for box, score, label in zip(boxes, scores, labels):
        if score < score_thresh:
            continue
        x0, y0, x1, y1 = box
        if (x1-x0) < MIN_BOX_SIZE or (y1-y0) < MIN_BOX_SIZE:
            continue
        kept.append({'bbox':[float(x0),float(y0),float(x1),float(y1)], 'score':float(score), 'label': class_texts[int(label)]})
    # simple NMS
    def iou(a,b):
        ax0, ay0, ax1, ay1 = a
        bx0, by0, bx1, by1 = b
        inter_x0, inter_y0 = max(ax0,bx0), max(ay0,by0)
        inter_x1, inter_y1 = min(ax1,bx1), min(ay1,by1)
        iw, ih = max(0, inter_x1-inter_x0), max(0, inter_y1-inter_y0)
        inter = iw*ih
        area_a = (ax1-ax0)*(ay1-ay0)
        area_b = (bx1-bx0)*(by1-by0)
        union = area_a + area_b - inter + 1e-6
        return inter/union
    kept.sort(key=lambda d: d['score'], reverse=True)
    final = []
    for det in kept:
        if all(iou(det['bbox'], f['bbox']) < DET_NMS_IOU for f in final):
            final.append(det)
    return final


def crop_boxes(image: Image.Image, detections: List[Dict], expand: float=0.05) -> List[Tuple[Image.Image, Dict]]:
    w, h = image.size
    crops = []
    for det in detections:
        x0, y0, x1, y1 = det['bbox']
        cx0 = max(0, int(x0 - expand*(x1-x0)))
        cy0 = max(0, int(y0 - expand*(y1-y0)))
        cx1 = min(w, int(x1 + expand*(x1-x0)))
        cy1 = min(h, int(y1 + expand*(y1-y0)))
        crop = image.crop((cx0, cy0, cx1, cy1))
        crops.append((crop, {**det, 'bbox_expanded': [cx0, cy0, cx1, cy1]}))
    return crops# Download dataset
