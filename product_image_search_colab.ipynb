# CLIP embedder (OpenCLIP ViT-L/14)
clip_model, _, clip_preprocess = open_clip.create_model_and_transforms('ViT-L-14', pretrained='openai')
clip_model = clip_model.to(DEVICE)
clip_model.eval()

@torch.no_grad()
def embed_pil(pil_img: Image.Image) -> np.ndarray:
    img = clip_preprocess(pil_img).unsqueeze(0).to(DEVICE)
    feat = clip_model.encode_image(img)
    feat = feat / feat.norm(dim=-1, keepdim=True)
    return feat.detach().cpu().numpy().astype('float32')
# Detection utils with OWL-ViT (open-vocabulary)
from typing import List, Tuple, Dict

owl_processor = Owlv2Processor.from_pretrained('google/owlv2-base-patch16')
owl_model = Owlv2ForObjectDetection.from_pretrained('google/owlv2-base-patch16').to(DEVICE)
owl_model.eval()

@torch.no_grad()
def ov_detect(image: Image.Image, class_texts: List[str], score_thresh: float=0.25, nms_iou: float=0.5) -> List[Dict]:
    inputs = owl_processor(text=[[c] for c in class_texts], images=image, return_tensors='pt')
    inputs = {k: v.to(DEVICE) for k, v in inputs.items()}
    outputs = owl_model(**inputs)
    target_sizes = torch.tensor([image.size[::-1]]).to(DEVICE)
    results = owl_processor.post_process_object_detection(outputs=outputs, target_sizes=target_sizes)
    res = results[0]

    boxes = res['boxes'].detach().cpu().numpy()
    scores = res['scores'].detach().cpu().numpy()
    labels = res['labels'].detach().cpu().numpy()

    # Filter by threshold and min size
    kept = []
    for i, (box, score, label) in enumerate(zip(boxes, scores, labels)):
        if score < score_thresh:
            continue
        x0, y0, x1, y1 = box
        if (x1 - x0) < MIN_BOX_SIZE or (y1 - y0) < MIN_BOX_SIZE:
            continue
        kept.append({
            'bbox': [float(x0), float(y0), float(x1), float(y1)],
            'score': float(score),
            'label': class_texts[int(label)]
        })

    # NMS on kept boxes
    if len(kept) == 0:
        return []
    b = np.array([k['bbox'] for k in kept], dtype=np.float32)
    s = np.array([k['score'] for k in kept], dtype=np.float32)
    # xyxy to xywh for supervision NMS
    xywh = np.copy(b)
    xywh[:, 2] = b[:, 2] - b[:, 0]
    xywh[:, 3] = b[:, 3] - b[:, 1]
    dets = sv.Detections(xyxy=b, confidence=s, class_id=None, tracker_id=None)
    keep_idx = sv.nn.non_max_suppression(detections=dets, iou_threshold=nms_iou)
    kept = [kept[i] for i in keep_idx]
    return kept


def crop_boxes(image: Image.Image, detections: List[Dict], expand: float=0.05) -> List[Tuple[Image.Image, Dict]]:
    w, h = image.size
    crops = []
    for det in detections:
        x0, y0, x1, y1 = det['bbox']
        cx0 = max(0, int(x0 - expand*(x1-x0)))
        cy0 = max(0, int(y0 - expand*(y1-y0)))
        cx1 = min(w, int(x1 + expand*(x1-x0)))
        cy1 = min(h, int(y1 + expand*(y1-y0)))
        crop = image.crop((cx0, cy0, cx1, cy1))
        crops.append((crop, {**det, 'bbox_expanded': [cx0, cy0, cx1, cy1]}))
    return crops
