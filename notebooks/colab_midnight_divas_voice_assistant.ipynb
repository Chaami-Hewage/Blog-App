import os, csv, re, tempfile, torch, numpy as np, soundfile as sf
import gradio as gr
import faiss
from sentence_transformers import SentenceTransformer
from transformers import AutoTokenizer, AutoModelForCausalLM, BitsAndBytesConfig, GenerationConfig
from faster_whisper import WhisperModel
from parler_tts import ParlerTTSForConditionalGeneration
from gtts import gTTS
from bs4 import BeautifulSoup
import requests

# Data setup
os.makedirs('data', exist_ok=True)

# Upload CSV in Colab UI if you want, else scrape a small sample
try:
  from google.colab import files
  up = files.upload()
  if 'products.csv' in up:
    with open('data/products.csv','wb') as f: f.write(up['products.csv'])
except Exception:
  pass

BASE_URL='https://www.midnightdivas.com'

def fetch(u):
  try: return requests.get(u, headers={'User-Agent':'Colab'}, timeout=20).text
  except Exception: return None

def parse_collection(u):
  html=fetch(u)
  if not html: return []
  soup=BeautifulSoup(html,'html5lib')
  links=[]
  for a in soup.select("a[href*='/products/']"):
    href=a.get('href') or ''
    if href.startswith('/'): href=BASE_URL+href
    if '/products/' in href and href not in links: links.append(href)
  return links

def parse_product(u, cat):
  html=fetch(u)
  if not html: return None
  soup=BeautifulSoup(html,'html5lib')
  h=soup.select_one('h1'); title=h.get_text(strip=True) if h else ''
  d=soup.select_one('.product__description') or soup.select_one('.description') or soup.select_one('#tab-description')
  desc=d.get_text('\n',strip=True) if d else ''
  p=soup.select_one('.price .money') or soup.select_one('.product__price') or soup.select_one('.price')
  price=p.get_text(strip=True) if p else ''
  return {'title':title,'description':desc,'price':price,'url':u,'category':cat}

if not os.path.exists('data/products.csv'):
  rows=[]
  for col in [f"{BASE_URL}/collections/babydolls", f"{BASE_URL}/collections/lingerie"]:
    cat=col.rstrip('/').split('/')[-1]
    for link in parse_collection(col)[:20]:
      pr=parse_product(link,cat)
      if pr and pr['title']: rows.append(pr)
  with open('data/products.csv','w',newline='',encoding='utf-8') as f:
    w=csv.DictWriter(f,fieldnames=['title','description','price','url','category'])
    w.writeheader(); [w.writerow(r) for r in rows]

# Build index
rows=[r for r in csv.DictReader(open('data/products.csv',encoding='utf-8'))]
corpus=[f"Title: {r['title']}. Category: {r['category']}. Price: {r['price']}. Details: {r['description']} URL: {r['url']}" for r in rows]
emb=SentenceTransformer('sentence-transformers/paraphrase-multilingual-mpnet-base-v2')
X=emb.encode(corpus, batch_size=64, show_progress_bar=True, convert_to_numpy=True, normalize_embeddings=True).astype('float32')
idx=faiss.IndexFlatIP(X.shape[1]); idx.add(X)

# Models
whisper=WhisperModel('medium', compute_type='float16')
bnb=BitsAndBytesConfig(load_in_4bit=True,bnb_4bit_quant_type='nf4',bnb_4bit_compute_dtype=torch.float16,bnb_4bit_use_double_quant=True)
tok=AutoTokenizer.from_pretrained('Qwen/Qwen2.5-3B-Instruct', use_fast=True)
llm=AutoModelForCausalLM.from_pretrained('Qwen/Qwen2.5-3B-Instruct', device_map='auto', torch_dtype=torch.float16, quantization_config=bnb, trust_remote_code=True)
gen_cfg=GenerationConfig(max_new_tokens=300, do_sample=True, temperature=0.9, top_p=0.9, repetition_penalty=1.05)
parler=ParlerTTSForConditionalGeneration.from_pretrained('parler-tts/parler-tts-mini-v1').to('cuda' if torch.cuda.is_available() else 'cpu')
parl_tok=AutoTokenizer.from_pretrained('parler-tts/parler-tts-mini-v1')
style_prompt='A warm, confident female brand ambassador with alluring yet tasteful tone.'

# Helpers
persona_en=("You are Midnight Divas' warm, confident, and sophisticated brand ambassador. "
"Your voice is alluring and emotionally engaging with subtle flirtatious energy—never explicit. "
"Use vivid, sensory language and highlight fit, fabric, mood, and occasion. Keep it classy and empowering. ")
style_example=("Set the mood in this fiery lace babydoll that hugs your curves in all the right places.\n\n"
"With its sultry cut-out details and delicate lace design, it’s the perfect mix of sweet and seductive.\n\n"
"Adjustable straps give you the perfect fit, while the matching panty completes the look for an irresistible finish.")

def detect_lang(text):
  return 'si' if re.search(r"[\u0D80-\u0DFF]", text) else 'en'

def retrieve(q, k=5):
  X=emb.encode([q], normalize_embeddings=True, convert_to_numpy=True).astype('float32')
  s,I=idx.search(X,k)
  out=[]
  for sc,i in zip(s[0],I[0]):
    if i>=0 and i<len(rows): out.append(rows[i])
  return out

def build_prompt(q, lang, ctx):
  sys = persona_en + f"\n\nStyle example:\n{style_example}"
  if lang=='si':
    inst='සිංහලයෙන් කෙටි, ආකර්ෂණීය පිළිතුරක්. වැදගත් නිෂ්පාදන තොරතුරු, මිල, link ඇතුළත් කරන්න.'
  else:
    inst='Craft a short, captivating reply with product info, price and link.'
  ctx_lines=[]
  for s in ctx:
    ctx_lines.append(f"- Title: {s['title']}\n  Price: {s['price']}\n  Details: {s['description']}\n  Link: {s['url']}")
  user=f"User query: {q}\n\nProduct context:\n"+"\n".join(ctx_lines)
  msgs=[{"role":"system","content":sys},{"role":"user","content":inst+"\n\n"+user}]
  return tok.apply_chat_template(msgs, tokenize=False, add_generation_prompt=True)

# Pipeline

def pipeline(audio):
  if audio is None: return 'No audio received.', None
  sr,data=audio
  with tempfile.NamedTemporaryFile(suffix='.wav', delete=False) as tmp: p=tmp.name
  sf.write(p, data, sr)
  segs,info=whisper.transcribe(p, beam_size=5, vad_filter=True); os.unlink(p)
  txt=' '.join([s.text.strip() for s in segs]).strip()
  if not txt: return "I couldn't hear you.", None
  lang=detect_lang(txt)
  ctx=retrieve(txt, 5)
  prompt=build_prompt(txt, lang, ctx)
  inputs=tok([prompt], return_tensors='pt').to(llm.device)
  with torch.no_grad(): out=llm.generate(**inputs, generation_config=gen_cfg)
  resp=tok.decode(out[0], skip_special_tokens=True)
  if resp.startswith(prompt): resp=resp[len(prompt):]
  if lang=='si':
    g=gTTS(text=resp, lang='si'); g.save('response.mp3'); return resp, 'response.mp3'
  else:
    si=parl_tok(style_prompt, return_tensors='pt').to(parler.device)
    ti=parl_tok(resp, return_tensors='pt').to(parler.device)
    with torch.no_grad(): audio = parler.generate(input_ids=ti.input_ids, prompt_input_ids=si.input_ids)[0].cpu().numpy()
    sf.write('response.wav', audio, 24000); return resp, 'response.wav'

with gr.Blocks() as demo:
  gr.Markdown('**Midnight Divas Voice Assistant**')
  a=gr.Audio(sources=['microphone'], type='numpy', label='Speak your question')
  t=gr.Textbox(label='Assistant')
  o=gr.Audio(label='Response audio')
  b=gr.Button('Ask')
  b.click(pipeline, inputs=[a], outputs=[t,o])

demo.launch()